<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- startupTimeLimit: startup migrates and seeds before it listens, and the first connection to the
           auto-paused Azure SQL database takes about a minute (the 120 s default kills the process mid-resume).
           stdout goes to %home%\LogFiles because wwwroot is read-only on App Service (run from package). -->
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%"
                  stdoutLogEnabled="true" stdoutLogFile="\\?\%home%\LogFiles\stdout"
                  hostingModel="outofprocess" startupTimeLimit="600" />
    </system.webServer>
  </location>
</configuration>
