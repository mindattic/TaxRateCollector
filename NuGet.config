<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for TaxRateCollector (TRC-T47).

    1. lib/local-packages/ (relative to this file): git-tracked copies of the private MindAttic.* packages this
       repo references (MindAttic.Legion, MindAttic.Vault). It is the only place a GitHub runner can get them:
       it has no C:\LocalNuGet, and without these copies the Azure deploy fails to restore.
    2. C:\LocalNuGet: the dev-box feed. Missing in CI, where the workflow restores with
       the ignore-failed-sources switch.
    3. nuget.org: everything else.

  When you bump a MindAttic package, copy the new .nupkg from C:\LocalNuGet into lib/local-packages/ and update
  the PackageReference (.gitignore re-includes this folder's *.nupkg).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-packages" value="./lib/local-packages" />
    <add key="LocalNuGet" value="C:\LocalNuGet" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
